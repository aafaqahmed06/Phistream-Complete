# Copy to .env.local:  cp .env.example .env.local
#
# Where the Phistream backend listens. The site proxies /api/*, /health and
# /docs to it (next.config.ts), so the browser only ever talks to this site's
# own port. Server rendering also calls the backend here directly.
#
# `npm run dev:all` starts the backend on this port for you.
BACKEND_URL=http://127.0.0.1:4000

# Staff sign-in for /admin (Supabase Auth). Both values are PUBLIC by design:
# Supabase Dashboard -> Project Settings -> API Keys -> "Publishable key".
# They only let staff sign in; all data still comes from the backend's
# staff-only admin API, which checks the staff list on every request.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
