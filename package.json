{
  "name": "phistream-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Phistream Studio",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "start:local": "node --env-file-if-exists=.env dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:migrations",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --project db",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/scripts/migrate.ts",
    "db:migrate:prod": "node dist/db/scripts/migrate.js",
    "db:seed": "tsx --env-file-if-exists=.env src/db/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "forms:publish": "tsx --env-file-if-exists=.env src/db/scripts/publish-application-form.ts",
    "forms:publish:prod": "node dist/db/scripts/publish-application-form.js",
    "staff": "tsx --env-file-if-exists=.env src/db/scripts/staff.ts",
    "staff:prod": "node dist/db/scripts/staff.js",
    "retention": "tsx --env-file-if-exists=.env src/db/scripts/retention.ts",
    "retention:prod": "node dist/db/scripts/retention.js",
    "docker:build": "docker build -t phistream-backend:local .",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
