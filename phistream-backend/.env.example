# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Production values come from the hosting platform's secret store.

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Local: `npm run db:up` starts PostgreSQL from compose.yaml on port 54329.
# Supabase: Project Settings -> Database -> Connection string. Use the pooled
# connection (Supavisor, transaction mode, port 6543) for the running API:
#   postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://phistream:phistream_local_only@localhost:54329/phistream

# Optional: connection used by `db:migrate`. Migrations take a session-level
# advisory lock, so use the DIRECT connection (db.<project-ref>.supabase.co:5432)
# or the session-mode pooler (port 5432) - not the transaction pooler (6543).
# Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=

# disable | require | verify-full
# Default: verify-full in production, disable otherwise. For Supabase with
# verify-full, set DATABASE_SSL_CA to the project's CA certificate (Project
# Settings -> Database -> SSL configuration). Any sslmode=... in the URL is ignored.
DATABASE_SSL=disable
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# Connections per process. Default 10, or 2 on Vercel (VERCEL=1), where many
# function instances run at once and Supabase's pooler allows only a few
# dozen connections in total (15 on the smallest plan).
DATABASE_POOL_MAX=10
# How long an unused connection stays open. Default 30000, or 5000 on Vercel.
# DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Per-statement limit for API queries (0 = none). Migrations never time out.
# Not applied through the transaction pooler (6543), which drops the setting.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Tests only: a DISPOSABLE database whose name contains "test". Its schema is
# dropped and recreated by `npm run test:db`.
# TEST_DATABASE_URL=postgres://phistream:phistream_local_only@localhost:54329/phistream_test

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs (development only; rejected in production)
LOG_PRETTY=true

# Comma-separated exact browser origins allowed to call the API (no wildcards, no paths).
# Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Proxy trust for client IP detection (affects rate limiting):
#   false            - direct traffic, ignore X-Forwarded-For (default)
#   1                - trust one proxy hop (typical managed container host / load balancer)
#   10.0.0.0/8,...   - trust only these proxy IPs/CIDRs
TRUST_PROXY=false

# Maximum request body size in bytes (default 100 KiB)
BODY_LIMIT_BYTES=102400

# Global default rate limit per client IP (routes may override)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Hard deadline for graceful shutdown before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# Maximum time to receive a whole request (slow-client protection)
REQUEST_TIMEOUT_MS=30000

# Cache-Control max-age (seconds) for public content responses; 0 = no-cache
CONTENT_CACHE_MAX_AGE_SECONDS=60

# POST /api/v1/contact: per-client-IP limit, separate from the global limit
# (default 5 requests per 10 minutes)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# POST /api/v1/applications: per-client-IP limit (default 5 per hour)
APPLICATION_RATE_LIMIT_MAX=5
APPLICATION_RATE_LIMIT_WINDOW_MS=3600000
# Lifetime of the applicant's status token (hours, 1-2160; default 7 days)
APPLICATION_STATUS_TOKEN_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Staff authentication (Supabase Auth) - enables /api/v1/admin/*
# ---------------------------------------------------------------------------
# Project URL (https://<project-ref>.supabase.co). Staff access tokens are
# verified against <url>/auth/v1/.well-known/jwks.json. Unset = admin API
# answers 503. Provision staff with: npm run staff -- add ... (docs/admin.md)
# SUPABASE_URL=
# Legacy projects only: the HS256 JWT secret (Project Settings -> API/JWT).
# Leave unset when the project uses asymmetric signing keys.
# SUPABASE_JWT_SECRET=
# STAFF_AUTH_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Scheduling (docs/scheduling.md). Unset SCHEDULING_PROVIDER = disabled.
# ---------------------------------------------------------------------------
# calcom | mock   (mock: local development only; refused in production)
# SCHEDULING_PROVIDER=mock
# SCHEDULING_TOKEN_TTL_HOURS=72
# Frontend page that reads #token=... and calls GET /api/v1/scheduling/session
# SCHEDULING_PAGE_URL=http://localhost:5173/schedule
#
# Cal.com (values come from the business's Cal.com account - never commit them):
# CALCOM_BOOKING_URL=https://cal.com/<team-or-user>/<hidden-event-type>
# CALCOM_WEBHOOK_SECRET=
# Optional, server-side only (booking lookup):
# CALCOM_API_KEY=
# CALCOM_API_BASE_URL=https://api.cal.com/v2
# CALCOM_API_VERSION=2024-08-13
#
# Mock provider (development):
# MOCK_SCHEDULING_WEBHOOK_SECRET=local-dev-secret-change-me

# ---------------------------------------------------------------------------
# Email (docs/notifications.md). Without Resend settings the "log" provider is
# used: nothing is sent. Production needs Resend or an explicit EMAIL_PROVIDER=log.
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=                     # secret, sending access only - never commit
# EMAIL_FROM="Phistream Studio <hello@mail.your-verified-domain>"
# EMAIL_REPLY_TO=
# STAFF_NOTIFICATION_EMAILS=          # comma-separated; default: active ADMIN staff
# ADMIN_DASHBOARD_URL=                # adds "Open application" links to staff emails
# NOTIFICATIONS_WORKER_ENABLED=true
# NOTIFICATIONS_POLL_INTERVAL_MS=15000
# NOTIFICATIONS_BATCH_SIZE=10
# NOTIFICATIONS_MAX_ATTEMPTS=8
# Send queued emails right after the request that queued them. Defaults to on
# when VERCEL=1, because serverless functions are paused between requests and
# the polling worker above cannot be relied on there.
# NOTIFICATIONS_DISPATCH_AFTER_RESPONSE=
# Secret for the daily sweep, GET /api/v1/internal/notifications/dispatch
# (vercel.json "crons"; Vercel sends it as a Bearer token). 16+ characters.
# Unset = that endpoint answers 404.
# CRON_SECRET=

# POST /api/v1/analytics/events: per-client-IP limit (default 120 per minute)
# ANALYTICS_RATE_LIMIT_MAX=120
# ANALYTICS_RATE_LIMIT_WINDOW_MS=60000

# Serve Swagger UI at /docs (defaults: on outside production, off in production)
# API_DOCS_ENABLED=true
